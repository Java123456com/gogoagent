OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_CACHE_CONTROL=true
DASHSCOPE_EMBEDDING_ENABLED=true
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
GOGO_MODEL=gpt-4o-mini
TAVILY_API_KEY=
GOGO_USE_LLM=false
GOGO_DATABASE_URL=sqlite:///./gogo_travel.db
REDIS_URL=
MEMORY_CACHE_TTL_SECONDS=1800
API_KEY_CACHE_TTL_SECONDS=604800

# 多实例部署：所有 API 节点必须使用同一个 Redis。开启后，服务启动时会校验 REDIS_URL。
CLUSTER_MODE=false
# 建议在每个节点设置唯一值，例如 gogo-api-1 / gogo-api-2；为空时自动使用 hostname-pid。
APP_INSTANCE_ID=
INTERRUPT_BROADCAST_CHANNEL=agent:interrupt
INTERRUPT_BROADCAST_POLL_SECONDS=0.25
SESSION_FENCE_TTL_SECONDS=86400
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MONITORED_TOOLS=query_weather,query_destination_news
CIRCUIT_BREAKER_EXCLUDED_TOOLS=
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_INITIAL_COOLDOWN_SECONDS=60
CIRCUIT_BREAKER_BACKOFF_MULTIPLIER=2.0
CIRCUIT_BREAKER_MAX_COOLDOWN_SECONDS=600
CIRCUIT_BREAKER_REDIS_KEY_PREFIX=tool:cb:
CIRCUIT_BREAKER_STATE_TTL_SECONDS=86400

# 统一工具执行策略（未知工具默认只超时、不自动重试）
TOOL_POLICY_ENABLED=true
TOOL_DEFAULT_TIMEOUT_SECONDS=60
TOOL_DEFAULT_MAX_ATTEMPTS=3
TOOL_RETRY_INITIAL_BACKOFF_SECONDS=3
TOOL_RETRY_BACKOFF_MULTIPLIER=2
TOOL_RETRY_MAX_BACKOFF_SECONDS=15
TOOL_RETRY_JITTER_RATIO=0.2
TOOL_POLICY_STRICT_REGISTRATION=false

# 子 Agent 执行隔离：local 适合开发，process 启用域级 Worker
SUBAGENT_EXECUTION_MODE=local
SUBAGENT_WORKER_COUNT_MANAGE=1
SUBAGENT_WORKER_COUNT_PLAN=1
SUBAGENT_WORKER_COUNT_INFO=1
SUBAGENT_WORKER_COUNT_BOOKING=1
SUBAGENT_WORKER_START_TIMEOUT_SECONDS=20
SUBAGENT_WORKER_SHUTDOWN_GRACE_SECONDS=5
SUBAGENT_WORKER_MAX_RESTARTS_PER_WINDOW=5
SUBAGENT_WORKER_RESTART_WINDOW_SECONDS=60
SUBAGENT_DEADLINE_MANAGE_SECONDS=120
SUBAGENT_DEADLINE_PLAN_SECONDS=600
SUBAGENT_DEADLINE_INFO_SECONDS=120
SUBAGENT_DEADLINE_BOOKING_SECONDS=300

# 百炼长期记忆与知识库配置。默认关闭，填完密钥后再开启。
BAILIAN_MEMORY_ENABLED=false
BAILIAN_KNOWLEDGE_ENABLED=false
BAILIAN_ACCESS_KEY_ID=
BAILIAN_ACCESS_KEY_SECRET=
BAILIAN_WORKSPACE_ID=
BAILIAN_INDEX_ID=
BAILIAN_MEMORY_LIBRARY_ID=
BAILIAN_PROJECT_ID=
BAILIAN_PROFILE_SCHEMA=
# 默认分别为 https://dashscope.aliyuncs.com 和 bailian.cn-beijing.aliyuncs.com；仅在需要覆盖时填写。
BAILIAN_MEMORY_ENDPOINT=https://dashscope.aliyuncs.com
BAILIAN_KNOWLEDGE_ENDPOINT=bailian.cn-beijing.aliyuncs.com
EXTERNAL_REQUEST_TIMEOUT_SECONDS=20
FAST_MODEL=qwen3.6-flash
STRONG_MODEL=qwen3.7-max
STABLE_MODEL=glm-5.1
STRONG_MODEL_WITH_THINKING=qwen3.7-max
# DashScope OpenAI-compatible extra_body: enable_thinking=true + this limit.
STRONG_MODEL_THINKING_BUDGET=2048
WEATHER_MCP_ENDPOINT=
WEATHER_MCP_REQUEST_TIMEOUT_SECONDS=30
WEATHER_MCP_ENABLED_TOOLS=["城市天气实况","城市15日预报","城市天气预警","城市空气实况","城市24小时预报","城市40日预报"]
ORIZN_VISA_API_KEY=
ORIZN_MCP_COMMAND=npx
ORIZN_MCP_ARGS=["--no-install","orizn-visa-mcp"]
ORIZN_MCP_INITIALIZATION_TIMEOUT_SECONDS=20
ORIZN_MCP_REQUEST_TIMEOUT_SECONDS=30
ORIZN_MCP_ENABLED_TOOLS=["quick_visa_check","check_visa_requirement"]
MCP_PERSISTENT_SESSIONS=true
NEWS_API_KEY=

# 第三方旅行能力。API Key 不在这里配置，由用户通过 Agent 工具加密保存。
TRAVEL_SEARCH_PROVIDERS=["tuniu-cli","flyai","flight-manager","rolling-go-hotel"]
# 生产必须改成至少 32 字节的随机值，所有服务节点保持一致。
API_KEY_ENCRYPT_SECRET=replace-with-a-strong-random-production-secret
RGH_WORKSPACE=./.runtime/rgh-users
RGH_TOKEN_TTL_SECONDS=2592000
RGH_LOGIN_WATCH_TIMEOUT_SECONDS=300
RGH_WORKSPACE_RETENTION_SECONDS=604800
RGH_LOGIN_OUTPUT_RETENTION_SECONDS=3600

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gogo-travel
